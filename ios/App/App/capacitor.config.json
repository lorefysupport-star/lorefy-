{
	"appId": "com.lorefy.app",
	"appName": "Lorefy",
	"webDir": "ios-web",
	"bundledWebRuntime": false,
	"server": {
		"iosScheme": "capacitor",
		"androidScheme": "https"
	},
	"plugins": {
		"SignInWithApple": {
			"clientId": "com.lorefy.app"
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound"
			]
		}
	},
	"packageClassList": [
		"SecureStorage",
		"SignInWithApple",
		"AppPlugin",
		"CAPBrowserPlugin",
		"CAPCameraPlugin",
		"FilesystemPlugin",
		"PushNotificationsPlugin",
		"SharePlugin"
	]
}
