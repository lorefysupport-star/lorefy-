{
  "name": "lorefy",
  "version": "1.0.0",
  "private": true,
  "description": "Lorefy mobile release shell and App Store preflight tooling.",
  "scripts": {
    "memory:context": "node tools/project-memory.mjs context",
    "memory:search": "node tools/project-memory.mjs search",
    "memory:refresh": "node tools/project-memory.mjs refresh",
    "memory:check": "node tools/project-memory.mjs check",
    "memory:audit": "node tools/project-memory.mjs audit",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "catalog:search-index": "node tools/build-catalog-search-index.mjs",
    "community:patch": "node tools/patch-community-cloud.js && node tools/patch-community-social.js && node tools/patch-product-report-cloud.js && node tools/patch-community-followups.js",
    "ios:prepare": "node tools/prepare-ios-web.mjs",
    "ios:add": "npm run ios:prepare && npx cap add ios",
    "ios:sync": "node tools/patch-apple-sign-in.mjs && npm run ios:prepare && npx cap sync ios && node tools/align-native-capacitor.mjs && node tools/fix-capacitor-spm-paths.mjs",
    "eas-build-post-install": "npm run ios:sync",
    "apple:audit": "node tools/apple-release-audit.mjs",
    "apple:audit:strict": "node tools/apple-release-audit.mjs --strict"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.0",
    "@capacitor-community/apple-sign-in": "7.1.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/camera": "8.2.4",
    "@capacitor/core": "8.4.3",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/push-notifications": "8.1.2",
    "@capacitor/share": "8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@capacitor/ios": "8.4.3",
    "csv-parse": "7.0.3",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@capacitor/core": "8.4.3",
    "@capacitor/android": "8.4.3"
  }
}
