-weight: 800 !important;\n  box-shadow: none !important;\n}\n\n.lf-auth .lf-primary {\n  color: #fff !important;\n  background: var(--auth-action) !important;\n  border: 1px solid var(--auth-action) !important;\n}\n\n.lf-auth .lf-primary:active {\n  background: var(--auth-action-pressed) !important;\n}\n\n.lf-auth .lf-white {\n  color: var(--auth-ink) !important;\n  background: #fff !important;\n  border: 1px solid var(--auth-line) !important;\n}\n\n.lf-auth .lf-label {\n  margin: 0 0 8px !important;\n  color: var(--auth-ink) !important;\n  font-size: 12px !important;\n}\n\n.lf-auth .lf-field {\n  min-height: 52px !important;\n  padding-inline: 14px !important;\n  color: var(--auth-ink) !important;\n  background: #fff !important;\n  border: 1px solid var(--auth-line) !important;\n  border-radius: 8px !important;\n  font-size: 16px !important;\n}\n\n.lf-auth .lf-field:focus,\n.lf-auth .lf-work-search:focus-within {\n  border-color: var(--auth-action) !important;\n  box-shadow: 0 0 0 3px #167b7722 !important;\n}\n\n.lf-auth .lf-tabs {\n  gap: 0;\n  margin: 24px 0 18px;\n  padding: 0;\n  border-bottom: 1px solid var(--auth-line);\n  border-radius: 0;\n  background: transparent !important;\n}\n\n.lf-auth .lf-tab,\n.lf-auth .lf-tab.on {\n  min-height: 46px !important;\n  border: 0 !important;\n  border-bottom: 2px solid transparent !important;\n  border-radius: 0 !important;\n  color: var(--auth-muted) !important;\n  background: transparent !important;\n  box-shadow: none !important;\n}\n\n.lf-auth .lf-tab.on {\n  color: var(--auth-action) !important;\n  border-bottom-color: var(--auth-action) !important;\n}\n\n.lf-auth .lf-sticky {\n  inset-inline: 20px;\n  bottom: calc(var(--nc-bottom) + 14px);\n  padding-bottom: 0 !important;\n  background: var(--auth-paper) !important;\n}\n\n.lf-auth .lf-error {\n  color: #ab3d3d !important;\n}\n\n.lf-auth .lf-selection-status {\n  margin: 0 0 8px;\n  color: var(--auth-ink);\n  font-size: 12px;\n  line-height: 1.5;\n  text-align: center;\n}\n\n/* An editorial opening with real reading imagery, then a quiet sign-in area. */\n.lf-auth[data-lf-auth-stage="welcome"],\n.lf-auth[data-lf-auth-stage="welcome"] .lf-page {\n  background: #142e30 !important;\n}\n\n.lf-auth[data-lf-auth-stage="welcome"] .lf-page::before {\n  content: "";\n  position: absolute;\n  inset: 0 0 auto;\n  height: 50%;\n  background: url("../launch/brand/lorefy-reading-scene.jpg") center 38% / cover no-repeat;\n  border-bottom: 3px solid var(--auth-coral);\n}\n\n.lf-auth[data-lf-auth-stage="welcome"] .lf-lang {\n  z-index: 2;\n  color: #fff !important;\n  background: #142e30d9 !important;\n  border-color: #ffffff4d !important;\n}\n\n.lf-auth[data-lf-auth-stage="welcome"] .lf-page > div:nth-child(2) {\n  min-height: 0;\n  justify-content: flex-end !important;\n  align-items: flex-start !important;\n  padding: 0 0 20px !important;\n  text-align: start !important;\n}\n\n.lf-auth[data-lf-auth-stage="welcome"] .lf-page > div:nth-child(2) > div:first-child {\n  flex-direction: row !important;\n  align-items: center !important;\n  gap: 10px !important;\n  margin-bottom: 14px;\n}\n\n.lf-auth[data-lf-auth-stage="welcome"] .lf-page > div:nth-child(2) > div:first-child > div {\n  width: 33px;\n  height: 33px;\n  background: url("../launch/brand/lorefy-feather.png") center / contain no-repeat;\n  mix-blend-mode: screen;\n}\n\n.lf-auth[data-lf-auth-stage="welcome"] .lf-page > div:nth-child(2) > div:first-child svg {\n  display: none;\n}\n\n.lf-auth[data-lf-auth-stage="welcome"] .lf-page > div:nth-child(2) strong {\n  color: #fff !important;\n  font-size: 26px !important;\n}\n\n.lf-auth[data-lf-auth-stage="welcome"] h1 {\n  max-width: 15ch;\n  margin: 0 0 9px !important;\n  color: #fff !important;\n  font-size: 23px !important;\n  line-height: 1.38 !important;\n  text-align: start !important;\n}\n\n.lf-auth[data-lf-auth-stage="welcome"] .lf-sub {\n  max-width: 34ch !important;\n  margin: 0 !important;\n  color: #c9d9d6 !important;\n  text-alig