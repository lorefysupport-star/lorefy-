rtant;\n  box-shadow: none !important;\n  outline: 0 !important;\n  font-size: 14px;\n}\n\n.lf-auth .lf-genre::before {\n  content: "";\n  position: absolute;\n  inset: 0 0 auto;\n  height: 4px;\n  background: var(--mood, var(--auth-action));\n}\n\n.lf-auth .lf-genre:nth-child(1) { --mood: #cb79a0; }\n.lf-auth .lf-genre:nth-child(2) { --mood: #dc8066; }\n.lf-auth .lf-genre:nth-child(3) { --mood: #6a9bab; }\n.lf-auth .lf-genre:nth-child(4) { --mood: #719179; }\n.lf-auth .lf-genre:nth-child(5) { --mood: #6694b3; }\n.lf-auth .lf-genre:nth-child(6) { --mood: #c69659; }\n.lf-auth .lf-genre:nth-child(7) { --mood: #d0a967; }\n.lf-auth .lf-genre:nth-child(8) { --mood: #817596; }\n\n.lf-auth .lf-genre.on {\n  color: var(--auth-action-pressed) !important;\n  background: var(--auth-selected) !important;\n  border-color: var(--auth-action) !important;\n}\n\n.lf-auth .lf-mark {\n  width: 24px;\n  height: 24px;\n  top: 8px;\n  border-radius: 50%;\n  color: #fff;\n  background: var(--auth-action) !important;\n}\n\n/* Browsable work rows keep every title readable beside its actual cover. */\n.lf-auth .lf-work-search {\n  flex: none;\n  min-height: 48px;\n  margin: 24px 0 11px;\n  color: var(--auth-muted) !important;\n  background: #fff !important;\n  border: 1px solid var(--auth-line) !important;\n  border-radius: 8px !important;\n}\n\n.lf-auth .lf-work-search input {\n  color: var(--auth-ink) !important;\n  font-size: 16px;\n}\n\n.lf-auth .lf-work-grid {\n  display: flex;\n  flex: 1;\n  flex-direction: column;\n  min-height: 0;\n  gap: 0;\n  padding: 0 0 92px;\n  overflow-y: auto;\n  scrollbar-width: none;\n}\n\n.lf-auth .lf-work-grid::-webkit-scrollbar {\n  display: none;\n}\n\n.lf-auth .lf-work {\n  display: flex;\n  align-items: center;\n  flex: none;\n  width: 100%;\n  min-height: 90px;\n  aspect-ratio: auto;\n  gap: 14px;\n  padding: 8px 10px !important;\n  border: 0 !important;\n  border-bottom: 1px solid var(--auth-line) !important;\n  border-radius: 0 !important;\n  color: