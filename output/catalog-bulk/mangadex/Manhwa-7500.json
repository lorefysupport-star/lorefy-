butes":{"title":{"ko-ro":"Gollyun e Yong i Sanda"},"altTitles":[{"ko":"곤륜에 용이 산다"},{"en":"A Dragon Lives in Kunlun"},{"en":"The Dragon of Kunlun"}],"description":{"en":"Gyo-ha becomes a disciple of the Kunlun Sect, which was once numbered among the legendary Nine Sects and One Gang. Together with his fellow disciples, he struggles against all odds to rebuild the fallen sect.\n\n...Except, something is a bit off.\n\nHis fellow disciples are former beggars, bandits, swindlers, and thieves?\n\nIs this… really an orthodox sect?"},"isLocked":false,"links":{"mu":"n2tu305","raw":"https://comic.naver.com/webtoon/list?titleId=852601"},"officialLinks":null,"originalLanguage":"ko","lastVolume":"","lastChapter":"","publicationDemographic":null,"status":"ongoing","year":2026,"contentRating":"safe","tags":[{"id":"391b0423-d847-456f-aff0-8b0cfc03066b","type":"tag","attributes":{"name":{"en":"Action"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"3e2b8dae-350e-4ab8-a8ce-016e844b9f0d","type":"tag","attributes":{"name":{"en":"Long Strip"},"description":{},"group":"format","version":1},"relationships":[]},{"id":"799c202e-7daa-44eb-9cf7-8a3c0441531e","type":"tag","attributes":{"name":{"en":"Martial Arts"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"87cc87cd-a395-47af-b27a-93258283bbc6","type":"tag","attributes":{"name":{"en":"Adventure"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"f5ba408b-0e7a-484d-8d49-4e9125ac96de","type":"tag","attributes":{"name":{"en":"Full Color"},"description":{},"group":"format","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2026-09-16T20:46:04+00:00","updatedAt":"2026-09-18T15:01:04+00:00","version":4,"availableTranslatedLanguages":[],"latestUploadedChapter":null},"relationships":[{"id":"6e3476c9-6a6a-4d1f-a6bb-0712f1e88cbd","type":"author","attributes":{"name":"Geum Uihaeng (금의행)","imageUrl":null,"biography":{},"twitter":null,"pixiv":null,"melonBook":null,"fanBox":null,"booth":null,"namicomi":null,"nicoVideo":null,"skeb":null,"fantia":null,"tumblr":null,"youtube":null,"weibo":null,"naver":null,"website":null,"createdAt":"2024-04-25T01:36:50+00:00","updatedAt":"2024-04-25T01:36:50+00:00","version":1}},{"id":"f9ea496b-5008-4b3d-bbfd-a8cb1027c696","type":"author","attributes":{"name":"Jeong Beomgu","imageUrl":null,"biography":{},"twitter":null,"pixiv":null,"melonBook":null,"fanBox":null,"booth":null,"namicomi":null,"nicoVideo":null,"skeb":null,"fantia":null,"tumblr":null,"youtube":null,"weibo":null,"naver":null,"website":null,"createdAt":"2026-09-16T20:42:42+00:00","updatedAt":"2026-09-16T20:42:42+00:00","version":1}},{"id":"5d66796c-e699-46dc-82d6-d0df0451aaec","type":"artist"},{"id":"196b7cb0-9fd9-414b-a152-0f3da6c71646","type":"cover_art","attributes":{"description":"","volume":"1","fileName":"b54bf874-be64-495b-85fc-cfeefa49d74f.jpg","locale":"ko","createdAt":"2026-09-16T20:46:05+00:00","updatedAt":"2026-09-16T20:46:05+00:00","version":1}},{"id":"086d46ca-9e85-47ef-8b2c-87ba0e922fc1","type":"creator"}]},{"id":"524d5ba0-6c1a-4bb1-8b85-5a19fc4cae3e","type":"manga","attributes":{"title":{"ko-ro":"Re:meet"},"altTitles":[{"ko":"리밋"},{"en":"Lovers, Cats, and the Killer"}],"description":{"fr":"Voici So Mooyun, un jeune policier fraîchement affecté au poste de police. Alors qu'il passait ses journées à courir partout sans répit, il découvre que son voisin n'est autre que Won Tae-i, un pompier qui lui avait laissé une première impression très mauvaise.\nLe poste de police de Seoheung et la caserne des pompiers de Seoheung étaient si proches que s'ils tombaient, leur nez se toucherait. Chaque jour, Mooyun et Tae-i se heurtaient inévitablement, se chamaillant et se rapprochant peu à peu.\nUn jour, une étrange affaire se présente devant eux, des chats et des chiens disparaissent dans le quartier ! Alors qu'ils enquêtent, le coupable finit par se dévoiler..."},"isLocked":false,"links":{"al