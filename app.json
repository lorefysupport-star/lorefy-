{
  "expo": {
    "name": "Lorefy",
    "slug": "lorefy",
    "scheme": "lorefy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/lorefy-icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lorefy.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#09080d",
        "foregroundImage": "./assets/lorefy-icon.png"
      },
      "package": "com.lorefy.app",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "8438f5d2-3734-4ef7-8925-c8ffeb5a0cd5"
      }
    },
    "owner": "lorefy"
  }
}
